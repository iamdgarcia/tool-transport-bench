# Copy this file to `.env` (same directory) and fill in your values.
# Any OpenAI-compatible endpoint works: OpenAI, a self-hosted gateway,
# OpenRouter, a local vLLM/Ollama with an OpenAI layer, etc.
#
#   cp .env.example .env

# Base URL of an OpenAI-compatible API (must include the /v1 if your provider uses it)
OPENAI_BASE_URL=https://api.openai.com/v1

# API key for that endpoint
OPENAI_API_KEY=sk-...

# Default model used by the benches (any chat model your endpoint serves)
OPENAI_MODEL=gemini-3.5-flash

# OPTIONAL: corporate proxy with TLS interception? Point this at the CA bundle.
# Leave unset on normal machines.
# SSL_CERT_FILE=/path/to/ca-bundle.pem
